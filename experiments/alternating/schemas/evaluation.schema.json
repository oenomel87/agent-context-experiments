{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis",
    "scores",
    "reason"
  ],
  "properties": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "facts",
        "evidence",
        "limitations"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "maxLength": 280
        },
        "facts": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quote",
              "relevance"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "relevance": {
                "type": "string",
                "maxLength": 160
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_clarity",
        "support_linkage",
        "qualification"
      ],
      "properties": {
        "claim_clarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "support_linkage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "qualification": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  }
}
